    </key>
    <key name="notify-sound" type="b">
      <default>true</default>
      <summary>Play a sound with notifications</summary>
    </key>
    <key name="spellcheck" type="b">
      <default>true</default>
      <summary>Spell-check the composer</summary>
    </key>
    <key name="low-data-calls" type="b">
      <default>false</default>
      <summary>Low-data mode for calls</summary>
    </key>
    <key name="window-w" type="i">
      <default>1180</default>
      <summary>Last window width (internal)</summary>
    </key>
    <key name="window-h" type="i">
      <default>760</default>
      <summary>Last window height (internal)</summary>
    </key>
    <key name="window-x" type="i">
      <default>-1</default>
      <summary>Last window X (internal)</summary>
    </key>
    <key name="window-y" type="i">
      <default>-1</default>
