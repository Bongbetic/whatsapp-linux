<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="com.bongbetic.WhatsAppLinux" path="/com/bongbetic/WhatsAppLinux/">
    <key name="autostart" type="b">
      <default>true</default>
      <summary>Start on login</summary>
    </key>
    <key name="close-to-tray" type="b">
      <default>true</default>
      <summary>Keep running in tray when the window closes</summary>
    </key>
    <key name="start-hidden" type="b">
      <default>false</default>
      <summary>Start hidden in tray</summary>
    </key>
    <key name="enter-to-send" type="b">
      <default>true</default>
      <summary>Enter sends, Shift+Enter inserts a newline</summary>
    </key>
    <key name="font-scale" type="d">
      <default>1.0</default>
      <summary>Chat font scale</summary>
    </key>
    <key name="download-dir" type="s">
      <default>''</default>
      <summary>Manual download directory (empty = XDG Downloads)</summary>
    </key>
    <key name="auto-download-photos" type="b">
      <default>true</default>
      <summary>Auto-download photos</summary>
    </key>
    <key name="auto-download-audio" type="b">
      <default>true</default>
      <summary>Auto-download voice notes and audio</summary>
    </key>
    <key name="auto-download-video" type="b">
      <default>false</default>
      <summary>Auto-download video</summary>
    </key>
    <key name="auto-download-docs" type="b">
      <default>false</default>
      <summary>Auto-download documents</summary>
    </key>
    <key name="notify-preview" type="b">
      <default>true</default>
