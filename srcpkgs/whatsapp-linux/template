# Template file for 'whatsapp-linux'
# Binary repack of the GitHub release asset (built by
# tools/build-xbps.sh in release.yml). version+checksum are bumped
# by the post-release job; never bump by hand.
pkgname=whatsapp-linux
version=0.0.0
revision=1
archs="x86_64 x86_64-musl aarch64 aarch64-musl"
short_desc="Unofficial WhatsApp client for Linux"
maintainer="Bongbetic <soubarna@live.in>"
license="MIT, MPL-2.0, GPL-3.0-only"
homepage="https://github.com/Bongbetic/whatsapp-linux"
distfiles="https://github.com/Bongbetic/whatsapp-linux/releases/download/${pkgname}-v${version}/${pkgname}-${version}_${revision}.${XBPS_TARGET_ARCH}.xbps"
checksum=UPDATE_ME_AFTER_FIRST_RELEASE
repository=nonfree
depends="gtk4>=4.16 gstreamer1>=1.28 gst-plugins-base1>=1.28 gst-plugins-good1>=1.28 gst-plugins-bad1>=1.28 pipewire>=1.0 sqlite>=3.0 libwebp>=1.0 libgirepository>=1.80 xdg-desktop-portal>=1.0 hicolor-icon-theme>=0.17 desktop-file-utils>=0.23"
nopie=yes
nostrip=yes

do_install() {
	# A .xbps is a plain tarball: unpack the staged payload as-is.
	tar -xf "${XBPS_SRCDISTDIR}/${pkgname}-${version}_${revision}.${XBPS_TARGET_ARCH}.xbps" \
		-C "${DESTDIR}" --exclude='./props.plist' --exclude='./files.plist'
}
